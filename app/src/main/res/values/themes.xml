<resources>
    <!-- Light only (plan §3): the brand never inverts with the system theme. -->
    <style name="Theme.Servix" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7F4EC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Android 12+ splash: Warm Ivory background, centred mark, no text. -->
    <style name="Theme.Servix.Starting" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/warm_ivory</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="windowSplashScreenBackground">@color/warm_ivory</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_servix_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Servix</item>
    </style>
</resources>
